// The relay (worker.mjs): one per Lax, on its person's own Cloudflare account, at lax-relay.<account>.workers.dev.
// The Mac's key: `npx wrangler secret put RELAY_KEY --config relay/wrangler.jsonc`, the same as ~/.lax/secrets/relay-key.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lax-relay",
  "main": "./worker.mjs",
  "compatibility_date": "2026-06-24",
  "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "Relay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }],
  "workers_dev": true
}
