{
  "name": "lax",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lax — a pixel companion for Claude Code that lives on an old phone.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings server.mjs",
    "install-hooks": "node scripts/install-hooks.mjs",
    "remove-hooks": "node scripts/install-hooks.mjs --remove",
    "install-service": "node scripts/install-launchd.mjs",
    "remove-service": "node scripts/install-launchd.mjs --remove",
    "logs": "tail -f ~/.lax/logs/server.log ~/.lax/logs/tunnel.log",
    "install-channel": "node scripts/install-channel.mjs",
    "remove-channel": "node scripts/install-channel.mjs --remove",
    "android": "node scripts/android.mjs",
    "test": "node scripts/test-levels.mjs && node --no-warnings scripts/test-channel.mjs && node --no-warnings scripts/test-brain.mjs && node --no-warnings scripts/test-actions.mjs",
    "move-home": "node scripts/move-home.mjs",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/headless": "6.0.0",
    "node-pty": "1.1.0",
    "zod": "^4.6.5"
  }
}
